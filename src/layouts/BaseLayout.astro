---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  transparentHeader?: boolean;
}
const { title, description, image, type, jsonLd, transparentHeader = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} jsonLd={jsonLd} />
  </head>
  <body>
    <div class="layout">
      <Header transparent={transparentHeader} />
      <main class="layout-main"><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .layout-main { flex: 1; }
</style>
