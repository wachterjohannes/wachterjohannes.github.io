---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found · Johannes Wachter" description="That page does not exist.">
  <div class="content wrap">
    <span class="kicker">// 404</span>
    <h1>Not found</h1>
    <p>That page does not exist. Try the <a href="/">writing</a> or the <a href="/projects">projects</a>.</p>
  </div>
</BaseLayout>

<style>
  .wrap { padding-top: var(--space-9); padding-bottom: var(--space-9); }
  h1 {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    font-size: var(--size-h1);
    letter-spacing: var(--tracking-display);
    margin: 12px 0 10px;
  }
</style>
