---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Badge from '../../components/Badge.astro';
import { projects } from '../../data/projects';

const description =
  'Open-source projects by Johannes Wachter: Symfony Mate, Modelflow-AI, symfony/ai, Pucene, PHP-Task and Nanbando. A lab, not a portfolio.';
---
<BaseLayout title="Projects · Johannes Wachter" description={description}>
  <div class="content wrap">
    <span class="kicker">// LAB</span>
    <h1>Projects</h1>
    <p class="intro">
      Projects here are a lab, not a portfolio: each one exists because building it taught me
      something I write about.
    </p>

    <div class="grid">
      {projects.map((p) => (
        <Card kicker="// PROJECT" title={p.name} href={`/projects/${p.slug}`} arrow={false}>
          <div class="badges">{p.badges.map(([v, l]) => <Badge variant={v}>{l}</Badge>)}</div>
          <p class="tagline">{p.tagline}</p>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .wrap { padding-top: var(--space-8); padding-bottom: var(--space-8); }
  h1 {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    font-size: var(--size-h1);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    margin: 12px 0 6px;
  }
  .intro { font-size: var(--size-body); color: var(--fg-2); margin: 0 0 var(--space-6); max-width: var(--width-content); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .badges { display: flex; gap: 6px; margin-bottom: 8px; flex-wrap: wrap; }
  .tagline { margin: 0; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
