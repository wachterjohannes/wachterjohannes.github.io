---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import { getSortedPosts } from '../utils/posts';
import { getSortedShorts } from '../utils/shorts';
import { formatDate, isoDate } from '../utils/date';
import heroImg from '../assets/hero.jpg';

const posts = await getSortedPosts();
const featured = posts[0];
const latest = posts.slice(1);

// The three most recent shorts, as a thin strip between the featured post and the
// rest of the writing. Deliberately not cards: staying visually light is what keeps
// it from competing with the featured post, whatever position it sits in.
const shorts = (await getSortedShorts()).slice(0, 3);

const meta = (p: typeof posts[number]) =>
  `${formatDate(p.data.pubDate)} · ${p.data.readingTime}`;

const description =
  'Johannes Wachter, Sulu core developer and open source enthusiast. Writing about what building CMS, search and LLMs actually teaches me, and what we can all learn from it.';
---
<BaseLayout title="Johannes Wachter" description={description} transparentHeader image="/johannes.jpg">
  <!-- Hero: his point of view, not a job title. Flat warm-dark surface (the kit's
       full-bleed hero image was unavailable); the portrait sits in a bordered ring. -->
  <section class="hero">
    <Image
      class="hero-bg"
      src={heroImg}
      alt=""
      aria-hidden="true"
      width={2400}
      height={1136}
      widths={[1280, 1920, 2400]}
      sizes="100vw"
      format="webp"
      quality={68}
      loading="eager"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="avatar">
        <img src="/johannes.jpg" alt="Johannes Wachter" width="104" height="104" />
      </div>
      <div class="hello">// HELLO</div>
      <h1>I&rsquo;m Johannes Wachter</h1>
      <p class="lead">
        Sulu Core Developer and open source enthusiast, writing about what building CMS,
        search and LLMs actually teaches me, and what we can all learn from it.
      </p>
    </div>
  </section>

  {featured && (
    <section class="content block">
      <div class="section-head"><span class="kicker">// FEATURED</span><span class="rule"></span></div>
      <Card
        kicker={featured.data.category}
        title={featured.data.title}
        meta={meta(featured)}
        href={`/blog/${featured.id}`}
      >
        {featured.data.description}
      </Card>
    </section>
  )}

  {shorts.length > 0 && (
    <section class="content shorts">
      <div class="section-head" style="margin-top: var(--space-6)"><span class="kicker muted-kicker">// SHORTS</span><span class="rule"></span></div>
      <ul class="shorts-list">
        {shorts.map((s) => (
          <li class="shorts-item">
            <a class="shorts-link" href={`/shorts/${s.id}`}>
              <time class="shorts-date" datetime={isoDate(s.data.pubDate)}>{formatDate(s.data.pubDate)}</time>
              <span class="shorts-title">{s.data.title}</span>
            </a>
            <p class="shorts-desc">{s.data.description}</p>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/shorts">All shorts &rarr;</a></p>
    </section>
  )}

  {latest.length > 0 && (
    <section class="content">
      <div class="section-head" style="margin-top: var(--space-6)"><span class="kicker">// LATEST</span><span class="rule"></span></div>
      <div class="stack">
        {latest.map((p) => (
          <Card kicker={p.data.category} title={p.data.title} meta={meta(p)} href={`/blog/${p.id}`}>
            {p.data.description}
          </Card>
        ))}
      </div>
      <p class="more"><a href="/blog">All writing &rarr;</a></p>
    </section>
  )}

  <section class="content bio">
    <div class="bio-card">
      <p>
        Core Dev <a href="/projects/sulu">Sulu</a> CMS &middot; Core Team
        <a href="/projects/symfony-ai">symfony/ai</a> &middot; Building Symfony Mate &middot;
        External Lecturer @ FH Vorarlberg
      </p>
      <div class="bio-actions">
        <Button variant="secondary" href="/about">More about me &rarr;</Button>
        <Button href="https://www.linkedin.com/in/wachterjohannes/" rel="noopener" target="_blank">Follow on LinkedIn</Button>
      </div>
      <p class="bio-aside">
        On the bad days, this is what I put on:
        <a href="https://open.spotify.com/intl-de/track/7LD3k81uHRfLMGvYOhDxmy" rel="noopener" target="_blank">Claude is in the Stand-up</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 460px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    /* Flat fallback behind the photo (also the color while the image loads). */
    background: oklch(0.24 0.014 75);
  }
  /* Optimized forest + peak photo, cropped to show the trees and the snowy
     summit (biased slightly right / upper). Always dark, so it reads the same
     in light and dark mode. */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 38%;
    z-index: 0;
  }
  /* Dark scrim for legibility: top-weighted (the sky is bright) plus a central
     pool under the headline. Keeps the moody look of the original design. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, oklch(0.12 0.01 75 / 0.74), oklch(0.15 0.011 75 / 0.5) 45%, oklch(0.16 0.012 75 / 0.66)),
      radial-gradient(100% 78% at 50% 42%, oklch(0.10 0.008 75 / 0.52), transparent 72%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 120px 24px 72px;
    color: oklch(0.97 0.008 85);
    max-width: 720px;
  }
  .avatar {
    width: 104px; height: 104px;
    margin: 0 auto 22px;
    border-radius: 50%;
    border: 2px solid oklch(0.97 0.008 85 / 0.5);
    padding: 4px;
  }
  .avatar img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 50%;
    display: block;
  }
  .hello {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: oklch(0.8 0.1 70);
  }
  .hero h1 {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    font-size: var(--size-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin: 14px 0 12px;
    color: inherit;
  }
  .lead {
    font-size: var(--size-h3);
    color: oklch(0.88 0.012 85);
    margin: 0 auto 10px;
    max-width: 640px;
    text-wrap: pretty;
  }
  /* Shorts strip: one hairline-separated row each, no card, muted kicker, small
     type. It should read as a footnote to the writing above it, not a second
     feed competing with it. */
  .shorts { padding-top: var(--space-6); }
  .muted-kicker { color: var(--fg-3); }
  .shorts-list { list-style: none; margin: 0; padding: 0; }
  .shorts-item {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border-1);
  }
  .shorts-item:last-child { border-bottom: 1px solid var(--border-1); }
  .shorts-link {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--fg-1);
    border-bottom: none;
  }
  .shorts-link:hover { color: var(--accent-text); }
  .shorts-date {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    color: var(--fg-3);
    flex: none;
  }
  .shorts-title {
    font-size: var(--size-small);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
  }
  .shorts-desc {
    margin: 2px 0 0;
    font-size: var(--size-small);
    color: var(--fg-3);
    /* One line only. The whole short is on /shorts; this is just a taste. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .shorts-link { flex-direction: column; gap: 2px; }
  }

  .block { padding-top: var(--space-7); }
  .content { padding-top: var(--space-7); }
  .stack { display: grid; gap: var(--space-4); }
  .more { margin: var(--space-5) 0 0; font-size: var(--size-small); }
  .bio { padding-top: var(--space-7); padding-bottom: var(--space-8); }
  .bio-card {
    border: 1px solid var(--border-1);
    border-radius: var(--radius-2);
    padding: var(--space-5);
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .bio-card p {
    flex: 1;
    min-width: 260px;
    font-size: var(--size-small);
    line-height: var(--leading-body);
    color: var(--fg-2);
    margin: 0;
  }
  .bio-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .bio-aside {
    flex-basis: 100%;
    margin: 4px 0 0;
    font-size: 13px;
    font-style: italic;
    color: var(--fg-3);
  }
  .bio-aside a { color: inherit; }

  /* Mobile hero: the photo is much wider than tall, so on a narrow hero `cover`
     keeps the full height and crops horizontally. Bias the crop rightward so the
     snowy peak and the central sky gap stay in frame instead of a flat wall of
     trees, shrink the band, and strengthen the scrim for the busier crop. */
  @media (max-width: 640px) {
    .hero { min-height: 400px; }
    .hero-bg { object-position: 70% 30%; }
    .hero-scrim {
      background:
        linear-gradient(180deg, oklch(0.11 0.01 75 / 0.8), oklch(0.14 0.011 75 / 0.55) 45%, oklch(0.15 0.012 75 / 0.72)),
        radial-gradient(120% 82% at 50% 46%, oklch(0.09 0.008 75 / 0.55), transparent 74%);
    }
    .hero-inner { padding: 92px 20px 52px; }
  }
</style>
