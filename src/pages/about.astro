---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';

// About/CV page. Work Experience and Education are kept as-is (accurate). The bio
// reflects his current Sulu + AI positioning; project names link to their detail
// pages. No em-dashes; date ranges keep en-dashes (allowed).
const facts: [string, string][] = [
  ['Location', 'Vorarlberg, Austria'],
  ['E-mail', 'johannes@sulu.io'],
  ['Sulu Developer', 'since August, 2013'],
];
const skills = ['PHP', 'Symfony', 'Sulu', 'JavaScript', 'Elasticsearch', 'LLM / RAG', 'MCP', 'Scrum'];
const work: [string, string, string, string][] = [
  ['August, 2018 – until now', 'Sulu GmbH', 'Sulu Core Developer', 'Development, support and conception of sulu and third party bundles. Additionally internal and external consulting about sulu and other topics.'],
  ['October, 2020 – until now', 'Vorarlberg University of Applied Science', 'External Lecturer', 'Holding of various seminars, courses and project coaching. Among others "Script and Web Technologies" and "Innovation Project".'],
  ['September, 2013 – September, 2018', 'MASSIVE ART WebServices GmbH', 'Sulu Core Developer', 'Conception and development of sulu, third-party bundles and consulting, half-time beside the study at first.'],
  ['June, 2010 – September, 2010', 'Liebherr Elektronik GmbH', 'Test Software Developer', 'Extended the project started for my thesis at the HTL Rankweil.'],
];
// Real talks only. [event, title, note?, url?]
const talks: [string, string, (string | undefined)?, string?][] = [
  ['SymfonyLive Berlin 2026 · SymfonyOnline 2026', 'Symfony Mate: Real Runtime Context for AI Coding Assistants'],
  ['SymfonyCon Vienna 2024', 'Flexibility in the Face of Uncertainty', 'Provider-agnostic, GDPR-aware AI in Symfony'],
  ['Never Code Alone, 12 June 2025', 'Sulu CMS 3.0 & AI: Live-Integration', 'With Roland Golla', 'https://www.youtube.com/live/PBkfMI5B4WQ'],
  ['Never Code Alone', 'Sulu 3.0 Content Update: Live-Demo & Überblick', undefined, 'https://www.youtube.com/live/IdOB0ldvr8A'],
  ['SymfonyCon Cluj 2017', 'Tired of fixing your CMS instead of creating awesome websites?', 'Sulu'],
  ['VLBG Webdev 2026', 'RAG beyond hello world'],
];
const edu: [string, string, string][] = [
  ['2005 – 2009', 'Höhere Lehranstalt für Elektronik und Technische Informatik', 'HTL Rankweil'],
  ['2010 – 2013', 'Software and Information Engineering', 'University of Applied Sciences Dornbirn'],
  ['2013 – 2015', 'Master of Science in Engineering', 'University of Applied Sciences Dornbirn'],
  ['2017', 'Elasticsearch Core Developer', 'Elastic'],
];

const description =
  'Johannes Wachter: core developer of Sulu, the open-source Symfony CMS, working where software engineering meets AI. Background, work, talks and education.';
---
<BaseLayout title="About · Johannes Wachter" description={description} image="/johannes.jpg">
  <section class="content intro">
    <div class="intro-text">
      <span class="kicker">// ABOUT</span>
      <h1>Johannes Wachter</h1>
      <p>
        Hello, I am Johannes Wachter. I am a core developer of <a href="/projects/sulu">Sulu</a>,
        the open-source Symfony CMS, and I have worked on it since the project&rsquo;s early days,
        mostly on the backend. I am based in Vorarlberg, Austria, and have been building with
        Symfony since around 2012.
      </p>
      <p>
        These days most of my energy goes into where software engineering meets AI. I started
        <a href="/projects/symfony-mate">Symfony Mate</a>, which gives AI coding assistants real
        runtime context from a running app, and <a href="/projects/modelflow-ai">Modelflow-AI</a>,
        a provider-agnostic PHP interface for AI models. I contribute to
        <a href="/projects/symfony-ai">symfony/ai</a>, teach as an external lecturer at FH
        Vorarlberg, and write about what building open source actually teaches you.
      </p>
      <dl class="facts">
        {facts.map(([k, v]) => (
          <div class="fact"><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>
    <figure class="portrait">
      <img src="/johannes.jpg" alt="Johannes Wachter" width="320" height="480" />
    </figure>
  </section>

  <section class="content sec">
    <div class="section-head"><span class="kicker">// SKILLS</span><span class="rule"></span></div>
    <div class="skills">{skills.map((s) => <Tag>{s}</Tag>)}</div>
    <p class="skills-note">Also works with C, C++, Java and C#.</p>
  </section>

  <section class="content sec">
    <div class="section-head"><span class="kicker">// WORK EXPERIENCE</span><span class="rule"></span></div>
    <div class="rows">
      {work.map(([date, co, role, desc]) => (
        <div class="row bordered">
          <div class="date">{date}</div>
          <div>
            <div class="co">{co}</div>
            <div class="role">{role}</div>
            <p class="desc">{desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="content sec">
    <div class="section-head"><span class="kicker">// SPEAKING</span><span class="rule"></span></div>
    <div class="rows tight">
      {talks.map(([event, title, note, url]) => (
        <div class="row">
          <div class="date">{event}</div>
          <div>
            <span class="edu-title">
              {url ? <a href={url} rel="noopener" target="_blank">{title}</a> : title}
            </span>
            {note && <span class="edu-inst"> · {note}</span>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="content sec">
    <div class="section-head"><span class="kicker">// EDUCATION</span><span class="rule"></span></div>
    <div class="rows tight">
      {edu.map(([date, title, inst]) => (
        <div class="row">
          <div class="date">{date}</div>
          <div><span class="edu-title">{title}</span> <span class="edu-inst">· {inst}</span></div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-7);
    align-items: start;
  }
  h1 {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    font-size: var(--size-h1);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    margin: 12px 0 16px;
  }
  .intro-text p {
    font-size: var(--size-body);
    line-height: var(--leading-body);
    color: var(--fg-1);
    margin: 0 0 16px;
    text-wrap: pretty;
  }
  .facts { margin: 20px 0 0; display: grid; gap: 6px; }
  .fact { display: flex; gap: 12px; font-size: var(--size-small); }
  .fact dt { font-family: var(--font-mono); color: var(--fg-3); width: 130px; margin: 0; }
  .fact dd { margin: 0; font-weight: var(--weight-medium); }

  .portrait { margin: 0; }
  .portrait img {
    width: 240px;
    max-width: 40vw;
    height: auto;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-2);
    display: block;
  }

  .sec { padding-top: var(--space-8); }
  .skills { display: flex; gap: 8px; flex-wrap: wrap; }
  .skills-note { font-family: var(--font-mono); font-size: 13px; color: var(--fg-3); margin: 14px 0 0; }
  .rows { display: grid; gap: var(--space-5); }
  .rows.tight { gap: var(--space-4); }
  .row { display: grid; grid-template-columns: 220px 1fr; gap: 20px; }
  .row.bordered { padding-bottom: var(--space-5); border-bottom: 1px solid var(--border-1); }
  .date { font-family: var(--font-mono); font-size: 13px; color: var(--fg-3); padding-top: 3px; }
  .co { font-size: var(--size-h3); font-weight: var(--weight-semibold); }
  .role { font-size: var(--size-small); color: var(--accent-text); margin: 2px 0 8px; }
  .desc { font-size: var(--size-small); line-height: var(--leading-body); color: var(--fg-2); margin: 0; }
  .edu-title { font-weight: var(--weight-medium); }
  .edu-inst { color: var(--fg-3); }

  @media (max-width: 720px) {
    .intro { grid-template-columns: 1fr; }
    .portrait { order: -1; }
    .row { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
