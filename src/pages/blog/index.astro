---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Tag from '../../components/Tag.astro';
import { getSortedPosts, getAllTags } from '../../utils/posts';
import { formatDate } from '../../utils/date';

const posts = await getSortedPosts();
const tags = await getAllTags();

const meta = (p: typeof posts[number]) =>
  `${formatDate(p.data.pubDate)} · ${p.data.readingTime}`;

const description =
  'Essays and field notes on Symfony, open source, and AI tooling, and how software engineering changes when agents join the process.';
---
<BaseLayout title="Writing · Johannes Wachter" description={description}>
  <div class="content wrap">
    <span class="kicker">// BLOG</span>
    <h1>Writing</h1>
    <p class="intro">Essays and field notes on Symfony, open source, and AI tooling, and how software engineering changes when agents join the process.</p>

    <div class="stack">
      {posts.map((p) => (
        <Card kicker={p.data.category} title={p.data.title} meta={meta(p)} href={`/blog/${p.id}`}>
          {p.data.description}
        </Card>
      ))}
    </div>

    <div class="topics">
      <span class="topics-label">topics:</span>
      {tags.map((t) => <Tag>{t}</Tag>)}
    </div>

    <p class="archive-link">
      Looking for older posts? Browse the <a href="/archive">archive</a> from asapo.at &rarr;
    </p>
  </div>
</BaseLayout>

<style>
  .wrap { padding-top: var(--space-8); padding-bottom: var(--space-8); }
  h1 {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    font-size: var(--size-h1);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    margin: 12px 0 6px;
  }
  .intro { font-size: var(--size-body); color: var(--fg-2); margin: 0 0 24px; max-width: var(--width-content); }

  .stack { display: grid; gap: var(--space-4); margin-top: var(--space-5); }
  .topics {
    display: flex;
    gap: 8px;
    margin-top: var(--space-6);
    align-items: center;
    flex-wrap: wrap;
  }
  .topics-label { font-family: var(--font-mono); font-size: 12px; color: var(--fg-3); margin-right: 4px; }
  .archive-link { margin-top: var(--space-6); font-size: var(--size-small); color: var(--fg-2); }
</style>
