---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import Tag from '../../components/Tag.astro';
import { getAllPosts } from '../../utils/posts';
import { formatDate, isoDate } from '../../utils/date';

export async function getStaticPaths() {
  // Generate a page for every post, regular and archived.
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, all: posts },
  }));
}

const { post, all } = Astro.props;
const { Content } = await render(post);
const { data } = post;

// "Next up" stays within the same kind: archived posts point to other archived
// posts, regular posts to other regular posts.
const nextUp = all
  .filter((p) => p.id !== post.id && p.data.archived === data.archived)
  .slice(0, 2);

const site = Astro.site ?? new URL('https://johanneswachter.dev');
const url = new URL(`/blog/${post.id}`, site).href;
const imageAbs = data.heroImage ? new URL(data.heroImage, site).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  ...(imageAbs ? { image: [imageAbs] } : {}),
  datePublished: isoDate(data.pubDate),
  dateModified: isoDate(data.pubDate),
  author: {
    '@type': 'Person',
    name: 'Johannes Wachter',
    url: 'https://johanneswachter.dev/about',
  },
  publisher: { '@type': 'Person', name: 'Johannes Wachter' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  keywords: data.tags.join(', '),
};
---
<BaseLayout
  title={`${data.title} · Johannes Wachter`}
  description={data.description}
  image={data.heroImage}
  type="article"
  jsonLd={jsonLd}
>
  <article class="content wrap">
    <a class="back" href={data.archived ? '/archive' : '/blog'}>&larr; {data.archived ? 'Archive' : 'Blog'}</a>
    <span class="kicker">{data.category}</span>
    <h1>{data.title}</h1>
    <div class="byline">{formatDate(data.pubDate)} · {data.readingTime} read · Johannes Wachter</div>
    {data.archived && (
      <p class="archive-note">
        Archived, originally posted on
        {' '}<a href={data.source} rel="noopener" target="_blank">asapo.at</a>
        {' '}({formatDate(data.pubDate)}).
      </p>
    )}
    {data.linkedin && (
      <a class="li-top" href={data.linkedin} rel="noopener" target="_blank">Discuss on LinkedIn &rarr;</a>
    )}

    {data.heroImage && (
      <figure class:list={['hero', { archive: data.archived }]}>
        <img src={data.heroImage} alt={data.heroAlt || data.title} />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    {data.linkedin && (
      <div class="li-cta">
        <Button href={data.linkedin} rel="noopener" target="_blank">Discuss on LinkedIn &rarr;</Button>
        <span class="li-note">This post was also published on LinkedIn. Join the discussion there.</span>
      </div>
    )}

    {data.tags.length > 0 && (
      <div class="tags">
        <span class="tags-label">tags:</span>
        {data.tags.map((t) => <Tag>{t}</Tag>)}
      </div>
    )}

    {nextUp.length > 0 && (
      <div class="next">
        {nextUp.map((p) => (
          <Card kicker="// NEXT UP" title={p.data.title} href={`/blog/${p.id}`}>
            {p.data.description}
          </Card>
        ))}
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .wrap { padding-top: var(--space-8); padding-bottom: var(--space-8); }
  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-3);
    border-bottom: none;
    margin-bottom: 24px;
  }
  .back:hover { color: var(--accent-text); }
  /* Subtle link under the title (only when a LinkedIn version exists). */
  .li-top {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    margin-bottom: 24px;
  }
  /* Prominent call to action at the end of the article. */
  .li-cta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--border-1);
  }
  .li-note { font-size: var(--size-small); color: var(--fg-3); }
  h1 {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    font-size: var(--size-h1);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    margin: 12px 0 10px;
  }
  .byline { font-family: var(--font-mono); font-size: 13px; color: var(--fg-3); margin-bottom: 28px; }
  .hero {
    margin: 0 0 32px;
  }
  .hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-2);
    display: block;
  }
  /* Archived covers vary in size (some are small logos); show them at natural
     size, centered and width-capped, rather than stretched to full width. */
  .hero.archive { text-align: center; }
  .hero.archive img {
    width: auto;
    max-width: min(100%, 520px);
    aspect-ratio: auto;
    object-fit: contain;
    display: inline-block;
  }
  .archive-note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-3);
    margin: 0 0 24px;
  }
  .tags { display: flex; gap: 8px; margin: 36px 0 0; align-items: center; flex-wrap: wrap; }
  .tags-label { font-family: var(--font-mono); font-size: 12px; color: var(--fg-3); margin-right: 4px; }
  .next {
    border-top: 1px solid var(--border-1);
    margin-top: 40px;
    padding-top: 28px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .next { grid-template-columns: 1fr; }
  }
</style>
