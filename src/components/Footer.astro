---
// Ported from ui_kits/website/index.html footer. Social links point at Johannes'
// real profiles; the asapo.at wordmark is replaced by johanneswachter.dev.
const year = new Date().getFullYear();
const links = [
  {
    label: 'GitHub',
    href: 'https://github.com/wachterjohannes',
    path: 'M12 2A10 10 0 0 0 8.84 21.5c.5.08.66-.23.66-.5v-1.7c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.16.59.67.5A10 10 0 0 0 12 2Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/johanneswachter/',
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11 22 14.1V21h-4v-6.2c0-1.48-.03-3.38-2.06-3.38-2.06 0-2.38 1.6-2.38 3.27V21h-4V9Z',
  },
  {
    label: 'E-mail',
    href: 'mailto:johannes@sulu.io',
    path: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v.4l8 5 8-5V6H4Zm16 2.6-8 5-8-5V18h16V8.6Z',
  },
];
---
<footer class="site-footer">
  <div class="bar page">
    <span class="copy">&copy; {year} Johannes Wachter &middot; johanneswachter.dev</span>
    <div class="socials">
      {links.map((l) => (
        <a class="icon-btn" href={l.href} aria-label={l.label} rel="me noopener" target="_blank">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={l.path} /></svg>
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-1);
    margin-top: var(--space-8);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .copy {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-3);
  }
  .socials { margin-left: auto; display: flex; gap: 6px; }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    color: var(--fg-3);
    border: 1px solid transparent;
    border-radius: var(--radius-1);
    transition: color var(--speed), background var(--speed);
  }
  .icon-btn:hover { color: var(--accent-text); background: var(--bg-2); }
</style>
